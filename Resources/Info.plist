<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Waycast</string>
    <key>CFBundleDisplayName</key>
    <string>Waycast</string>
    <key>CFBundleIdentifier</key>
    <string>com.waycast.macos</string>
    <key>CFBundleVersion</key>
    <string>2.1</string>
    <key>CFBundleShortVersionString</key>
    <string>2.1</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>Waycast</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <!-- macOS 26+ 用 Assets.car 里的原生 Liquid Glass 图标；老系统回退到上面那份 AppIcon.icns。
         没有这个键，Tahoe 会把图标判定为旧式图标，缩小约 20% 塞进灰色托盘（icon jail）。 -->
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>zh_CN</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>zh_CN</string>
        <string>zh-Hans</string>
    </array>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Waycast</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSAppleEventsUsageDescription</key>
    <string>Waycast 需要控制应用以启动搜索结果。</string>
    <key>NSSystemAdministrationUsageDescription</key>
    <string>Waycast 需要辅助功能权限以响应全局快捷键。</string>
</dict>
</plist>
